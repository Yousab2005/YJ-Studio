# Copy to .env and fill values from Supabase Dashboard > Project Settings > Database / API.
# Use the pooler connection string (transaction/session mode compatible with your chosen deployment).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key (new sb_secret_... key or legacy service_role key). Never use in Vite/client variables.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=yj-studio-media
NODE_ENV=production
PORT=8787
# Comma-separated production origins if the app is hosted on a different origin.
ALLOWED_ORIGINS=
DB_POOL_MAX=5
