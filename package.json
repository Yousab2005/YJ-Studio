{
  "name": "yj-studio-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "npm run start",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "oxlint src scripts vite.config.ts",
    "test": "vitest run",
    "smoke": "node scripts/smoke-local.mjs",
    "preview": "vite preview",
    "db:migrate:local": "echo \"Use supabase/migrations/202610280001_initial_schema.sql in the Supabase SQL Editor.\"",
    "db:migrate:remote": "echo \"Use supabase/migrations/202610280001_initial_schema.sql in the Supabase SQL Editor.\"",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy": "npm run build",
    "start": "tsx server/index.ts",
    "db:export:sqlite": "python scripts/export-d1.py",
    "db:import:snapshot": "tsx scripts/import-snapshot.ts"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@hono/node-server": "^1.19.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.6",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
